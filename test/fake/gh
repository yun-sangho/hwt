#!/usr/bin/env bun
// Fake gh for tests: PRs live in $HWT_FAKE_STATE (prs), and merges happen in the bare repo $HWT_FAKE_ORIGIN, the
// way GitHub does them: squash = one commit on the base, update-branch = merge the base into the head.
import { load, save, type FakePr } from "./state.ts";

const args = process.argv.slice(2);
const s = load();
const origin = process.env.HWT_FAKE_ORIGIN!;
const out = (v: unknown) => process.stdout.write((typeof v === "string" ? v : JSON.stringify(v)) + "\n");
const git = (...a: string[]) => {
  const p = Bun.spawnSync({ cmd: ["git", "-C", origin, ...a], stdout: "pipe", stderr: "pipe" });
  return { ok: p.exitCode === 0, out: p.stdout.toString().trim() };
};
const count = (range: string) => Number(git("rev-list", "--count", range).out) || 0;
const arg = (key: string) => args.find((value) => value.startsWith(key + "="))?.slice(key.length + 1);
const queueCapacity = (pr: FakePr) => s.nativeQueues?.[pr.base] ?? (pr.mergeQueue ? 1 : null);
const queueId = (pr: FakePr) => "MQ_" + pr.base;
const squash = (pr: FakePr) => {
  const tree = git("merge-tree", "--write-tree", pr.base, pr.head);
  if (!tree.ok) process.exit(1);
  const c = git("commit-tree", tree.out.split("\n")[0]!, "-p", pr.base, "-m", `squash ${pr.head}`).out;
  git("update-ref", `refs/heads/${pr.base}`, c);
  Object.assign(pr, { state: "MERGED", sha: c });
};

const flag = (name: string) => {
  const i = args.indexOf(name);
  return i >= 0 ? args[i + 1] : undefined;
};

if (args[0] === "--version") out("gh 0.0.0-fake");
else if (args[0] === "run" && args[1] === "list") {
  const wf = flag("--workflow");
  const sha = flag("--commit");
  const runs = (s.runs ?? []).filter((r) => (!wf || r.workflow === wf) && r.sha === sha);
  for (const r of runs) {
    if (r.completeAfter !== undefined && --r.completeAfter <= 0) Object.assign(r, { status: "completed", conclusion: r.then ?? "success", completeAfter: undefined });
  }
  save(s);
  out(runs.map(({ databaseId, status, conclusion, workflow }) => ({ databaseId, status, conclusion, workflowName: workflow, url: `https://github.com/test/repo/actions/runs/${databaseId}` })));
}
else if (args[0] === "auth") process.exit(0);
else if (args[0] === "api" && args[1] === "graphql") {
  const id = arg("id")?.replace(/^PR_/, "");
  const pr = id ? s.prs?.[id] : null;
  if (!pr || pr.queueReadError) process.exit(1);
  const head = git("rev-parse", pr.head).out;
  const capacity = queueCapacity(pr);
  if (arg("query")?.startsWith("mutation")) {
    s.calls.push({ cmd: "gh enqueuePullRequest", arg: { n: id, head: arg("head") } });
    if (arg("head") !== head || capacity === null || capacity <= 0 || pr.state !== "OPEN" || pr.checks !== "pass" || pr.mergeQueue === "queued") {
      save(s);
      process.exit(1);
    }
    pr.mergeQueue = "queued";
    save(s);
    out({ data: { enqueuePullRequest: { mergeQueueEntry: { id: "MQE_" + id } } } });
    process.exit(0);
  }
  if (arg("base")) {
    out({
      state: pr.state,
      baseRefName: pr.base,
      headRefOid: head,
      repository: {
        mergeQueue: capacity === null ? null : { id: queueId(pr), configuration: { maximumEntriesToBuild: capacity } },
      },
    });
    process.exit(0);
  }
  if (pr.mergeQueue === "queued" && pr.mergeAfterPolls && --pr.mergeAfterPolls === 0) {
    squash(pr);
    delete pr.mergeQueue;
  }
  save(s);
  out({
    state: pr.state,
    mergeCommit: pr.sha ? { oid: pr.sha } : null,
    mergeQueueEntry: pr.mergeQueue === "queued" ? { id: "MQE_" + id, mergeQueue: { id: queueId(pr) } } : null,
    autoMergeRequest: pr.autoMerge ? { enabledAt: "2026-11-26T00:00:00Z" } : null,
  });
} else if (args[0] === "pr") {
  const [, sub, n] = args;
  const pr = s.prs?.[n!];
  if (!pr) process.exit(1);
  s.calls.push({ cmd: `gh pr ${sub}`, arg: { n } });
  if (sub === "view") {
    const conflict = pr.state === "OPEN" && !git("merge-tree", "--write-tree", pr.base, pr.head).ok;
    const behind = pr.state === "OPEN" && count(`${pr.head}..${pr.base}`) > 0;
    out({
      id: "PR_" + n,
      url: "https://github.com/test/repo/pull/" + n,
      headRefOid: git("rev-parse", pr.head).out,
      state: pr.state,
      mergeCommit: pr.sha ? { oid: pr.sha } : null,
      mergeable: conflict ? "CONFLICTING" : "MERGEABLE",
      mergeStateStatus: conflict ? "DIRTY" : behind && !s.behindAllowed ? "BEHIND" : pr.checks === "pending" ? "BLOCKED" : "CLEAN",
      baseRefName: pr.base,
      statusCheckRollup: pr.checks === "none" ? [] : [{ name: "ci", conclusion: pr.checks === "pass" ? "SUCCESS" : pr.checks === "fail" ? "FAILURE" : "", state: pr.checks === "pending" ? "PENDING" : "" }],
    });
  } else if (sub === "merge") {
    if (pr.state !== "OPEN" || pr.checks !== "pass") process.exit(1);
    if (queueCapacity(pr) !== null) {
      pr.mergeQueue = "queued";
      save(s);
      process.exit(0);
    }
    squash(pr);
  } else if (sub === "update-branch") {
    const tree = git("merge-tree", "--write-tree", pr.head, pr.base);
    if (!tree.ok) process.exit(1);
    const c = git("commit-tree", tree.out.split("\n")[0]!, "-p", pr.head, "-p", pr.base, "-m", `merge ${pr.base}`).out;
    git("update-ref", `refs/heads/${pr.head}`, c);
    pr.checks = "pending"; // CI runs again
  } else process.exit(2);
  save(s);
} else process.exit(2);
